{
  "name": "phonectl",
  "version": "0.1.0",
  "description": "Termux-local phone control CLI with explicit execution identities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "phonectl": "./bin/phonectl.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node --check bin/phonectl.js",
    "test": "pnpm run build && pnpm run test:types && node --test test/*.test.js",
    "test:types": "tsc -p tsconfig.test.json",
    "prepack": "pnpm run check && pnpm test"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
