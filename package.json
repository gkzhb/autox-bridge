{
  "name": "autox-bridge-workspace",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "test:types": "pnpm -r run test:types",
    "start": "pnpm --filter autox-bridge start",
    "cli": "pnpm --filter autox-bridge exec node bin/autox-bridge.js",
    "pack:bridge": "pnpm --filter autox-bridge pack",
    "phonectl": "node packages/phonectl/bin/phonectl.js",
    "pack:phonectl": "pnpm --filter phonectl pack",
    "audit:packs": "node scripts/audit-packs.mjs"
  }
}
